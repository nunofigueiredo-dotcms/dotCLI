  #set($borderRadius = "0")
#elseif($dotContentMap.dotStyleProperties.get("border-radius") == "medium")
  #set($borderRadius = "0.375rem")
#elseif($dotContentMap.dotStyleProperties.get("border-radius") == "large")
  #set($borderRadius = "0.5rem")
#else
  #set($borderRadius = "0.125rem")
#end

