#if($dotContentMap.dotStyleProperties.get("card-background") == "gray")
  #set($bgColor = "#F3F4F6")
#elseif($dotContentMap.dotStyleProperties.get("card-background") == "light-blue")
  #set($bgColor = "#EFF6FF")
#elseif($dotContentMap.dotStyleProperties.get("card-background") == "light-green")
  #set($bgColor = "#F0FDF4")
#else
  #set($bgColor = "#FFFFFF")
#end

