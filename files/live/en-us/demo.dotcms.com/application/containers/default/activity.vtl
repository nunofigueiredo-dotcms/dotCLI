  #set($titleFontSize = "0.875rem")
#elseif($dotContentMap.dotStyleProperties.get("title-size") == "text-base")
  #set($titleFontSize = "1rem")
#elseif($dotContentMap.dotStyleProperties.get("title-size") == "text-lg")
  #set($titleFontSize = "1.125rem")
#elseif($dotContentMap.dotStyleProperties.get("title-size") == "text-2xl")
  #set($titleFontSize = "1.5rem")
#elseif($dotContentMap.dotStyleProperties.get("title-size") == "text-3xl")
  #set($titleFontSize = "1.875rem")
#else
  #set($titleFontSize = "1.25rem")
#end

