#if($dotContentMap.dotStyleProperties.get("card-effects") && $dotContentMap.dotStyleProperties.get("card-effects").get("shadow"))
  #set($boxShadow = "0 10px 15px -3px rgba(0,0,0,0.1),0 4px 6px -4px rgba(0,0,0,0.1)")
#else
  #set($boxShadow = "0 4px 6px -1px rgba(0,0,0,0.1),0 2px 4px -2px rgba(0,0,0,0.1)")
#end

## ── Card border ───────────────────────────────────────────────
#if($dotContentMap.dotStyleProperties.get("card-effects") && $dotContentMap.dotStyleProperties.get("card-effects").get("border"))
  #set($cardBorder = "1px solid #E5E7EB")
#else
  #set($cardBorder = "none")
#end

## ── Title weight ──────────────────────────────────────────────
#if($dotContentMap.dotStyleProperties.get("title-style") && $dotContentMap.dotStyleProperties.get("title-style").get("bold"))
  #set($titleWeight = "700")
#else
  #set($titleWeight = "400")
#end

## ── Button color ──────────────────────────────────────────────
#if($dotContentMap.dotStyleProperties.get("button-color") == "green")
  #set($btnBg = "#22C55E")
  #set($btnBgHover = "#15803D")
#elseif($dotContentMap.dotStyleProperties.get("button-color") == "red")
  #set($btnBg = "#EF4444")
  #set($btnBgHover = "#B91C1C")
#elseif($dotContentMap.dotStyleProperties.get("button-color") == "purple")
  #set($btnBg = "#A855F7")
  #set($btnBgHover = "#7E22CE")
#elseif($dotContentMap.dotStyleProperties.get("button-color") == "orange")
  #set($btnBg = "#F97316")
  #set($btnBgHover = "#C2410C")
#elseif($dotContentMap.dotStyleProperties.get("button-color") == "teal")
  #set($btnBg = "#14B8A6")
  #set($btnBgHover = "#0F766E")
#else
  #set($btnBg = "#3B82F6")
  #set($btnBgHover = "#1D4ED8")
#end

## ── Button size ───────────────────────────────────────────────
#if($dotContentMap.dotStyleProperties.get("button-size") == "small")
  #set($btnPadding = "0.375rem 0.75rem")
  #set($btnFontSize = "0.875rem")
#elseif($dotContentMap.dotStyleProperties.get("button-size") == "large")
  #set($btnPadding = "0.75rem 1.5rem")
  #set($btnFontSize = "1.125rem")
#else
  #set($btnPadding = "0.5rem 1rem")
  #set($btnFontSize = "1rem")
#end

## ── Button radius ─────────────────────────────────────────────
#if($dotContentMap.dotStyleProperties.get("button-style") && $dotContentMap.dotStyleProperties.get("button-style").get("rounded"))
  #set($btnRadius = "0.5rem")
#else
  #set($btnRadius = "9999px")
#end

## ── Button shadow ─────────────────────────────────────────────
#if($dotContentMap.dotStyleProperties.get("button-style") && $dotContentMap.dotStyleProperties.get("button-style").get("shadow"))
  #set($btnShadow = "0 10px 15px -3px rgba(0,0,0,0.1),0 4px 6px -4px rgba(0,0,0,0.1)")
#else
  #set($btnShadow = "none")
#end

## ── Layout & scoping class ────────────────────────────────────
#set($layout = "left")
#if($dotContentMap.dotStyleProperties.get("layout"))
  #set($layout = $dotContentMap.dotStyleProperties.get("layout"))
#end
#set($cls = "activity-$dotContentMap.identifier")

<style>
.$cls {
  overflow: hidden;
  margin-bottom: 1rem;
  background-color: $bgColor;
  border-radius: $borderRadius;
  box-shadow: $boxShadow;
  border: $cardBorder;
  #if($layout == "overlap")
  position: relative;
  min-height: 24rem;
  padding: 0;
  #elseif($layout == "right")
  display: flex;
  flex-direction: row-reverse;
  padding: 1rem;
  #elseif($layout == "center")
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 1rem;
  #else
  display: flex;
  flex-direction: row;
  padding: 1rem;
  #end
}

.$cls .img-wrap {
  #if($layout == "overlap")
  position: absolute;
  inset: 0;
  z-index: 0;
  #elseif($layout == "center")
  position: relative;
  width: 100%;
  #else
  position: relative;
  flex-shrink: 0;
  width: 50%;
  #end
}

.$cls .img-inner {
  position: relative;
  width: 100%;
  overflow: hidden;
  #if($layout == "overlap")
  height: 100%;
  #else
  height: $imgHeight;
  #end
}

.$cls .img-inner img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.$cls .content {
  #if($layout == "overlap")
  position: relative;
  z-index: 10;
  padding: 2rem;
  background-color: rgba(255,255,255,0.9);
  min-height: 24rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  #elseif($layout == "center")
  width: 100%;
  padding: 1rem 1.5rem;
  #else
  flex: 1;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  #end
}

.$cls .title {
  margin-bottom: 0.5rem;
  font-size: $titleFontSize;
  font-weight: $titleWeight;
  #if($dotContentMap.dotStyleProperties.get("title-style") && $dotContentMap.dotStyleProperties.get("title-style").get("italic"))
  font-style: italic;
  #end
  #if($dotContentMap.dotStyleProperties.get("title-style") && $dotContentMap.dotStyleProperties.get("title-style").get("underline"))
  text-decoration: underline;
  #end
}

.$cls .desc {
  font-size: $descFontSize;
  margin-bottom: 1rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.$cls .link-wrap {
  #if($layout == "center")
  display: flex;
  justify-content: center;
  #end
}

.$cls .btn {
  display: inline-block;
  font-weight: 700;
  color: #FFFFFF;
  text-decoration: none;
  padding: $btnPadding;
  font-size: $btnFontSize;
  background-color: $btnBg;
  border-radius: $btnRadius;
  box-shadow: $btnShadow;
  transition: background-color 0.3s;
}

.$cls .btn:hover {
  background-color: $btnBgHover;
}
</style>

## ── Render ────────────────────────────────────────────────────
<article class="$cls">
  #if($dotContentMap.image)
  <div class="img-wrap">
    <div class="img-inner">
      <img
        src="/dA/${dotContentMap.identifier}/image/320maxh/270ch/270cw/80q/$dotContentMap.image.name"
        alt="$!{dotContentMap.title}"
      />
    </div>
  </div>
  #end
  <div class="content">
    <p class="title">$!{dotContentMap.title}</p>
    <p class="desc"
      #if($EDIT_MODE)
        data-language="$CONTENT_LANGUAGE"
        data-mode="minimal"
        data-inode="$ContentInode"
        data-field-name="description"
      #end
    >$UtilMethods.prettyShortenString("$dotContentMap.description", 120)</p>
    <div class="link-wrap">
      <a href="/activities/$urlTitle" class="btn">
        Link to detail →
      </a>
    </div>
  </div>
</article>
