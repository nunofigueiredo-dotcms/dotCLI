<h1>$!{dotPageContent.title}</h1>
#foreach($activity in $dotcontent.pull("+contentType:Activity +(conhost:${host.identifier} conhost:SYSTEM_HOST) +variant:default",10,"modDate desc"))
    <h2>$!{velocityCount}. $!{activity.title} #editContentlet($!{activity.inode})</h2>
    #if($activity.modDate)
        <p><strong>Last updated:</strong> $date.format("MMMM dd, yyyy", $activity.modDate)</p>
    #end
    <p>$!{activity.description}</p>
    #if($activity.tourguides && !$activity.tourguides.isEmpty())
        <p><strong>Tour Guide(s):</strong>
        #foreach($guide in $activity.tourguides)
            <b>$!{guide.name}</b>
        #end
        </p>
    #end
#end
